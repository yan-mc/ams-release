{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ams-update/1",
  "type": "object",
  "required": [
    "schema",
    "channel",
    "sequence",
    "components",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "ams-update/1"
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "dev"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "withdraw": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version",
          "url",
          "size",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "launcher",
              "kernel",
              "plugin",
              "service",
              "tool",
              "catalog"
            ]
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "requires": {
            "type": "object"
          },
          "notes": {
            "type": "string"
          },
          "mirrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:"
    }
  }
}